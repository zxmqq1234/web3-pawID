# PawID JWS 图片代理服务端环境变量示例（只列名字与安全说明，不填真实值）
# 说明：以下全部是服务端变量，禁止加 VITE_ 前缀，禁止写入前端代码、URL、日志或构建产物。
# 真实 Key 只在 Vercel/服务器环境变量中配置，本地用 .env（已在 .gitignore）且永不提交。

# 上游 JWS 密钥（服务端内存使用，不回显、不记录、不返回前端）
JWS_API_KEY=
# 上游基础地址（由部署环境决定；生产须 https，本地回环可用 http mock）
JWS_API_BASE_URL=
# 图片模型标识（由环境决定，不在代码中硬编码模型名）
JWS_IMAGE_MODEL=
# 生图路径（以 / 开头，不含查询串，由环境决定）
JWS_IMAGE_GENERATIONS_PATH=
# 上游请求超时毫秒（可选，默认 20000，范围 1000-60000）
JWS_REQUEST_TIMEOUT_MS=
# prompt 最大字符数（可选，默认 2000，范围 1-8000）
JWS_MAX_PROMPT_LENGTH=
# 前端请求体最大字节数（可选，默认 32768，范围 1024-131072）
JWS_MAX_BODY_BYTES=
# 单张 base64 图片解码后最大字节数（可选，默认 4194304）
JWS_MAX_IMAGE_BYTES=
# 上游响应体最大字节数（可选，默认 8388608，防大响应占内存）
JWS_MAX_UPSTREAM_BYTES=
# 限流窗口内最大请求数（可选，默认 30）
JWS_RATE_LIMIT_MAX=
# 限流窗口毫秒（可选，默认 60000）
JWS_RATE_LIMIT_WINDOW_MS=
# 是否严格校验 Origin（可选，1/true 开启；开启且配白名单时才严格）
JWS_STRICT_ORIGIN_ENABLED=
# 允许的 Origin 白名单，逗号分隔（可选，仅严格模式下生效）
JWS_ALLOWED_ORIGINS=
